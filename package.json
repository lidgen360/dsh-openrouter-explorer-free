{
  "name": "dsh-openrouter-explorer-free",
  "version": "0.11.2",
  "description": "OpenRouter Explorer Free — DeepSeek Harness plugin: live OpenRouter catalog with prices, free models, rankings and \"ride for free\" auto-routing, plus in-harness generation of images, video and speech.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "openrouter",
    "models",
    "pricing",
    "agent-harness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/menu.jpg",
    "assets/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node --check index.js && node --check lib/client.js && node --test \"tests/**/*.test.mjs\"",
    "install-smoke": "bash scripts/install-smoke.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidgen360/dsh-openrouter-explorer-free.git"
  },
  "bugs": {
    "url": "https://github.com/lidgen360/dsh-openrouter-explorer-free/issues"
  },
  "homepage": "https://explorer.lidogenerator.top",
  "author": {
    "name": "Lidgen 360",
    "url": "https://lidogenerator.top"
  }
}
